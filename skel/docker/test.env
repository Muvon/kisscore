# Config for `docker/test` — the ephemeral, isolated test harness.
# Sourced as a shell file (yoda vars like COMPOSE_PROJECT_NAME/REVISION are
# available). Adjust for your app. Extra args to `docker/test` are forwarded to
# TEST_CMD, so `docker/test --filter=Foo` works.

# The image tests run inside (defaults to the yoda-tagged deploy image).
# TEST_IMAGE="${COMPOSE_PROJECT_NAME}/php:${REVISION:-latest}"

# What runs inside it. The framework entry is `vendor/bin/test`; point it at
# your test dir + a bootstrap that sets up the app env (Env::init etc.).
TEST_CMD="php vendor/bin/test app/tests --bootstrap=app/tests/bootstrap.php"

# Env the app needs to know it is a test run + a writable env/ on tmpfs.
TEST_PHP_ENV="-e APP_ENV=test"
TEST_PHP_TMPFS="/src/env:rw,size=256m"
# TEST_PREP="mkdir -p /src/env/etc /src/env/var /src/env/log /src/env/run /src/env/tmp"

# --- Database (leave TEST_DB_IMAGE unset to run WITHOUT a database) -----------
# When set, DB_IP/DB_PORT/DB_USER/DB_PASSWORD/DB_DATABASE are injected into the
# php run automatically.
# TEST_DB_IMAGE="${COMPOSE_PROJECT_NAME}/db:latest"
# TEST_DB_INITDB="docker/containers/db/initdb"
# TEST_DB_PORT="3306"
# TEST_DB_NAME="app_test"
# TEST_DB_PASSWORD="test_root"
# TEST_DB_TMPFS="/var/lib/mysql:rw,size=2g"
# TEST_DB_CMD="--bind-address=0.0.0.0 --skip-log-bin"
