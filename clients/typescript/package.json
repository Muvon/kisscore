{
	"name": "@muvon/kisscore-client",
	"version": "1.0.0",
	"description": "Zero-dependency TypeScript client for KissCore API",
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "tsup src/index.ts --format cjs,esm --dts",
		"prepublishOnly": "npm run build"
	},
	"devDependencies": {
		"tsup": "^8.0.0",
		"typescript": "^5.4.0"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/muvon/kisscore",
		"directory": "clients/typescript"
	}
}
