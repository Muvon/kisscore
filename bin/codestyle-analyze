#!/usr/bin/env bash

# Resolve to physical path (avoids macOS case-sensitivity issues with require_once)
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd -P )"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd -P)"
cd "$PROJECT_DIR" || exit 1

if [ $# -eq 0 ]; then
	paths=(app/core app/lib app/plugin)
else
	paths=("$@")
fi

# PHPStan is not compatible with opcache — use enable_cli=0
vendor/bin/phpstan \
	--memory-limit=-1 \
	analyse \
	-c phpstan.neon \
	-- "${paths[@]}"
