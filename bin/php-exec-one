#!/usr/bin/env bash
set -e
if [[ -z "$1" ]]; then
  echo "Usage: $0 [path-to-file]"
  exit 1
fi

# Determine project root
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
if [[ -f "$SCRIPT_DIR/../../../autoload.php" ]]; then
  PROJECT_DIR="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
else
  PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
fi

lockfile="$PROJECT_DIR/env/run/${1##*/}.lock"
exec 9> "$lockfile"
flock -x -n 9 || {
  >&2 echo 'Instance is running already'
  exit 1
}

# Keep the inode stable: unlinking a flock file allows concurrent holders on
# different inodes. The kernel releases the lock when the process exits.
exec "$SCRIPT_DIR/php-exec" "$1" "${@:2}"
