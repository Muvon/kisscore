#!/usr/bin/env bash
if [[ -z "$1" ]]; then
  echo "Usage: $0 [path-to-file]"
  exit 1
fi

# Determine project root
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
if [[ -f "$SCRIPT_DIR/../../../autoload.php" ]]; then
  PROJECT_DIR="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
else
  PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
fi

lockfile="$PROJECT_DIR/env/run/${1##*/}.lock"
trap release SIGSEGV SIGINT SIGTERM
release() {
  rm -f "$lockfile"
}

exec 9> "$lockfile"
flock -x -n 9 || {
  >&2 echo 'Instance is running already'
  >&2 echo "You can remove lock file to fix it: $lockfile"
  exit 1
}

"$SCRIPT_DIR/php-exec" "$1" "${@:2}"
release
