#!/usr/bin/env bash
set -e

# Determine project root
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
if [[ -f "$SCRIPT_DIR/../../../autoload.php" ]]; then
  # Inside vendor/muvon/kisscore/bin/ — go up to project root
  PROJECT_DIR="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
else
  # Standalone or copied to project bin/
  PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
fi

if [ -e /.inited ]; then
  echo 'Skipping first initialization'
else
  echo "Running first initialization"

  echo "Preparing env/* dirs"
  mkdir -p "$PROJECT_DIR/env/backup" "$PROJECT_DIR/env/etc" "$PROJECT_DIR/env/log" "$PROJECT_DIR/env/run" "$PROJECT_DIR/env/tmp" "$PROJECT_DIR/env/var"

  touch /.inited 2>/dev/null || true
fi

php=$(which php)
config=$($php --ini | head -n 1)
config=${config##* }

OPTS=''
if [[ -f $config ]]; then
  OPTS='-c '$config
  echo "Found php config – $config"
fi

echo "Running Env::init()"
$php $OPTS <<EOF
<?php
  require_once '$PROJECT_DIR/vendor/autoload.php';
  Env::init('$PROJECT_DIR');

  // Rebuild the model field-schema cache on the Env::init path (NOT App::start,
  // which reads this cache and would deadlock a cold env). A project without a
  // DB skips it. A configured DB that does not answer is an init FAILURE: a
  // silent skip left the app dying later on the missing cache with a misleading
  // "include_once env/etc/model/…" error, hiding the real cause (DB down, wrong
  // credentials). Build is unguarded so a real failure aborts init.
  \$has_db = config('mysql.use_env') ? (string)getenv('DB_IP') !== '' : (array)config('mysql.shard') !== [];
  if (!\$has_db) {
    echo 'Model schema cache: skipped (no DB configured)' . PHP_EOL;
    return;
  }
  try {
    Plugin\Data\DB::ping();
  } catch (\Throwable \$e) {
    fwrite(STDERR, 'Model schema cache: DB ping failed — ' . \$e->getMessage() . PHP_EOL);
    exit(1);
  }
  echo 'Model schema cache: ' . Plugin\Data\Model::generateSchemaCache() . ' models' . PHP_EOL;
EOF

echo 'Done'
