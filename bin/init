#!/usr/bin/env bash
set -e

# Determine project root
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
if [[ -f "$SCRIPT_DIR/../../../autoload.php" ]]; then
  # Inside vendor/muvon/kisscore/bin/ — go up to project root
  PROJECT_DIR="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
else
  # Standalone or copied to project bin/
  PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
fi

if [ -e /.inited ]; then
  echo 'Skipping first initialization'
else
  echo "Running first initialization"

  echo "Preparing env/* dirs"
  mkdir -p "$PROJECT_DIR/env/backup" "$PROJECT_DIR/env/etc" "$PROJECT_DIR/env/log" "$PROJECT_DIR/env/run" "$PROJECT_DIR/env/tmp" "$PROJECT_DIR/env/var"

  touch /.inited 2>/dev/null || true
fi

php=$(which php)
config=$($php --ini | head -n 1)
config=${config##* }

OPTS=''
if [[ -f $config ]]; then
  OPTS='-c '$config
  echo "Found php config – $config"
fi

echo "Running Env::init()"
$php $OPTS <<EOF
<?php
  require_once '$PROJECT_DIR/vendor/autoload.php';
  Env::init('$PROJECT_DIR');

  // Rebuild the model field-schema cache on the Env::init path (NOT App::start,
  // which reads this cache and would deadlock a cold env). No DB -> skip; ping
  // throws when it's down. Build is unguarded so a real failure aborts init.
  try { Plugin\Data\DB::ping(); } catch (\Throwable \$e) { return; }
  echo 'Model schema cache: ' . Plugin\Data\Model::generateSchemaCache() . ' models' . PHP_EOL;
EOF

echo 'Done'
